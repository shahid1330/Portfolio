# GitHub — used to show live stars/forks/language on the project cards.
# Username is required. Token is optional; add one only if you hit the
# 60-requests/hour unauthenticated rate limit.
NEXT_PUBLIC_GITHUB_USERNAME=shahid1330
NEXT_PUBLIC_GITHUB_TOKEN=

# Contact details. Anything left blank is hidden by the UI rather than
# rendered as an empty link.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_GITHUB=https://github.com/shahid1330

# Contact form delivery (Web3Forms). The site is a static export, so the
# browser posts directly and this key ships in the bundle - Web3Forms keys
# are designed to be public. Get one at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Set only for GitHub Pages, where the site lives at /Portfolio.
# Leave blank locally so `npm run dev` serves from the root.
NEXT_PUBLIC_BASE_PATH=
